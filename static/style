:root{
  --bg:#f3f6fb; --card:#fff; --text:#1c2333; --muted:#64708a; --border:#e2e8f3;
  --primary:#2f5bea; --primary-d:#2347c0;
  --low:#1f9d55; --low-bg:#e8f7ee; --med:#d98a00; --med-bg:#fff4dc; --high:#d93a3a; --high-bg:#fdeaea;
  --shadow:0 6px 24px rgba(30,50,100,.08);
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0f1420; --card:#171e2e; --text:#e7ecf6; --muted:#93a0bb; --border:#26304a;
        --low-bg:#12301f; --med-bg:#3a2d0b; --high-bg:#3b1618; --shadow:0 6px 24px rgba(0,0,0,.4);}
}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);line-height:1.5}
.hero{text-align:center;padding:48px 20px 56px;color:#fff;background:linear-gradient(135deg,#2f5bea,#6a3df0)}
.hero .logo{font-size:44px}
.hero h1{margin:6px 0 8px;font-size:2.2rem;letter-spacing:.3px}
.hero p{max-width:560px;margin:0 auto;opacity:.92}
.container{max-width:760px;margin:-32px auto 40px;padding:0 16px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:22px;margin-bottom:18px;box-shadow:var(--shadow)}
label{font-weight:600;display:block;margin-bottom:8px}
.row{display:flex;gap:10px}
input[type=text]{flex:1;padding:13px 14px;border:2px solid var(--border);border-radius:10px;font-size:1rem;background:var(--bg);color:var(--text);outline:none;transition:.15s}
input[type=text]:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(47,91,234,.18)}
button{font:inherit;cursor:pointer}
#btn{background:var(--primary);color:#fff;border:0;border-radius:10px;padding:0 24px;font-weight:600;transition:.15s}
#btn:hover{background:var(--primary-d)} #btn:disabled{opacity:.7;cursor:wait}
.error{color:var(--high);margin:10px 0 0;font-weight:500}
.examples{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:.85rem;color:var(--muted)}
.chip{background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:999px;padding:4px 12px;font-size:.8rem;transition:.15s}
.chip:hover{border-color:var(--primary);color:var(--primary)}
.result{border-left:6px solid var(--low);animation:pop .3s ease}
.result.medium{border-left-color:var(--med)} .result.high{border-left-color:var(--high)}
@keyframes pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.verdict{display:flex;gap:14px;align-items:center;margin-bottom:18px}
.verdict .icon{font-size:2.4rem}
.verdict h2{margin:0;font-size:1.5rem}
.result.low h2{color:var(--low)} .result.medium h2{color:var(--med)} .result.high h2{color:var(--high)}
.url{margin:2px 0 0;color:var(--muted);word-break:break-all;font-size:.9rem;font-family:Consolas,monospace}
.meter-label{display:flex;justify-content:space-between;font-size:.9rem;margin-bottom:6px}
.meter{height:14px;background:linear-gradient(90deg,var(--low),var(--med),var(--high));border-radius:999px;position:relative;overflow:hidden}
.meter .fill{position:absolute;right:0;top:0;bottom:0;background:var(--border);width:100%;transition:width .6s ease;
  /* grey mask covers the unfilled part */}
.meter .fill{left:auto}
.meter-scale{display:flex;justify-content:space-between;font-size:.72rem;color:var(--muted);margin-top:4px}
h3{margin:22px 0 8px;font-size:1.05rem}
.reasons{list-style:none;padding:0;margin:0}
.reasons li{padding:8px 12px 8px 36px;margin-bottom:6px;border-radius:8px;position:relative;background:var(--med-bg)}
.reasons li::before{content:"⚠️";position:absolute;left:10px}
.muted{color:var(--muted)}
.advice{margin-top:16px;padding:12px 14px;border-radius:10px;background:var(--high-bg);font-size:.92rem}
.advice.ok{background:var(--low-bg)}
details{margin-top:16px} summary{cursor:pointer;color:var(--primary);font-weight:600}
.features{width:100%;border-collapse:collapse;margin-top:10px;font-size:.88rem}
.features th,.features td{text-align:left;padding:6px 10px;border-bottom:1px solid var(--border)}
.features th{background:var(--bg)} .features td:first-child{text-transform:capitalize}
.tips h3{margin-top:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grid p{margin:2px 0 0;color:var(--muted);font-size:.9rem}
footer{text-align:center;color:var(--muted);font-size:.8rem;padding:0 16px 30px}
@media (max-width:600px){.row{flex-direction:column}#btn{padding:12px}.grid{grid-template-columns:1fr}.hero h1{font-size:1.7rem}}
